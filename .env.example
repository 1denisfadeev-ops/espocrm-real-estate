# Шаблон настроек. Скопируй в .env и подставь свои значения:
#
#   cp .env.example .env
#
# Значения ниже — заглушки, их нужно заменить. Сгенерировать нормальные
# пароли можно так:
#
#   openssl rand -base64 24
#
# Файл .env в репозиторий не попадает: он в .gitignore. Не коммить его
# и не присылай в мессенджеры — это ключи от твоей CRM и базы.

# Имя проекта Docker. Без него compose берёт имя папки, а если в пути
# есть русские буквы или пробелы — ругается на недопустимое имя.
COMPOSE_PROJECT_NAME=espocrm

# Пароли базы данных. Задаются при первом запуске и дальше меняются
# только вместе с базой: CRM подключается к ней именно с этим паролем.
MARIADB_ROOT_PASSWORD=change_me_root_password
MARIADB_PASSWORD=change_me_db_password

# Учётка администратора CRM. Срабатывает только при первом запуске,
# дальше пароль меняется внутри CRM, в профиле пользователя.
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change_me_admin_password

# Порты на твоей машине. Если 8080 занят — поставь, например, 8090.
HTTP_PORT=8080
WS_PORT=8081
